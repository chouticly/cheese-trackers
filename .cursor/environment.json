{
	"name": "Cheese Trackers",
	"install": "bash .cursor/install.sh",
	"start": "bash .cursor/start.sh",
	"terminals": [
		{
			"name": "backend",
			"command": "cd server && cargo run"
		},
		{
			"name": "frontend",
			"command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173 --strictPort"
		}
	],
	"ports": [
		{
			"name": "backend",
			"port": 3000
		},
		{
			"name": "frontend",
			"port": 5173
		}
	]
}
